# Copy to .env on the server (never commit .env). Secrets live only here or in a secret manager.
SECRET_KEY=change-me-64-random-chars
POSTGRES_PASSWORD=change-me
SITE_URL=https://manasety.ai

# Staging (deploy step 2): noindex + basic auth on the whole site
STAGING=0
STAGING_USER=
STAGING_PASSWORD=

# Lead forwarding — REQUIRED so demo requests keep reaching Marsoud CRM and the email backup.
# Same values the current page uses (moved from browser JS to the server).
MARSOUD_CONTACT_TOKEN=
WEB3FORMS_ACCESS_KEY=
MARSOUD_LEAD_URL=https://marsoud.com/api/v1/public/contact-lead
N8N_LEAD_WEBHOOK_URL=

# Email notifications through the existing Microsoft 365 account
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFY_TO=hello@manasety.ai

# Search Console dashboard (phase 3): service-account JSON path inside the container
GSC_CREDENTIALS_FILE=
GSC_PROPERTY=sc-domain:manasety.ai

# Off-server backups (deploy/backup.sh): any rclone remote, e.g. "b2:manasety-backups"
BACKUP_REMOTE=
